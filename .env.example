# Environment Configuration — copy this file to .env and fill in your values
# NEVER commit .env to version control

# 🔑 Google Gemini API
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 🔑 Google Cloud Text-to-Speech
# Path to your GCP service-account JSON key file
# Docs: https://cloud.google.com/text-to-speech/docs/before-you-begin
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-service-account-key.json

# ⚙️ Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
